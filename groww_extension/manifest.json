{
  "manifest_version": 3,
  "name": "Groww Quant Auto-Order Bridge",
  "version": "1.2",
  "description": "Automatically populates trade quantities and parameters from your local Quant Terminal into Groww",
  "permissions": ["storage", "activeTab", "notifications"],
  "host_permissions": [
    "*://*.groww.in/*",
    "https://groww.in/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:9012/*",
    "http://127.0.0.1:9012/*",
    "http://test-admin.housiey.com/*",
    "https://test-admin.housiey.com/*",
    "http://test-admin.housiey.com:9012/*",
    "https://test-admin.housiey.com:9012/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.groww.in/*",
        "https://groww.in/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
